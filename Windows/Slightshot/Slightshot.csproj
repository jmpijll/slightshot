<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Slightshot.ico</ApplicationIcon>
    <AssemblyName>Slightshot</AssemblyName>
    <Version>1.4.1</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Slightshot.Core/Slightshot.Core.csproj" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../Resources/MenuBarTemplate.png" LogicalName="Slightshot.MenuBarTemplate.png" /></ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
